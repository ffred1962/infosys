# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в .gitignore — никогда не коммитьте реальные секреты.

# Нужен для поиска фирм на /crm/firm_finder (core/firm_search.py).
ANTHROPIC_API_KEY=

# Опционально — модель для поиска фирм. По умолчанию claude-sonnet-5.
ANTHROPIC_MODEL=

# Опционально — секрет для подписи сессионных cookie (core/auth.py).
# Если не задан, используется небезопасное значение по умолчанию — не для продакшена.
SESSION_SECRET_KEY=

# Опционально — true/1/yes, чтобы пометить сессионную cookie флагом Secure
# (https_only у SessionMiddleware, core/auth.py). По умолчанию false — для
# локальной разработки по http://127.0.0.1:8000 без TLS. Включайте только
# когда сервис реально доступен по HTTPS (ngrok-туннель, прод-деплой).
SESSION_COOKIE_SECURE=

# MCP-мост для Claude (Desktop/claude.ai), смонтированный в КОРНЕ приложения
# (api/mcp_server.py, core/mcp_oauth.py) — авторизация через OAuth 2.1, каждый
# пользователь логинится под своим обычным аккаунтом InfoSys, отдельного ключа
# не нужно. MCP_PUBLIC_BASE_URL — адрес, по которому Claude реально достучится
# до этого сервера: локально http://127.0.0.1:8000, при пробросе через
# ngrok/облако — тот внешний https-адрес. Коннектор в Claude настраивается на
# {MCP_PUBLIC_BASE_URL}/mcp (например http://127.0.0.1:8000/mcp) — без ключа,
# Claude сам обнаружит OAuth. Меняется при каждом перезапуске бесплатного
# ngrok-туннеля (новый поддомен) — тогда обновите это значение, перезапустите
# сервер и переподключите коннектор в Claude заново.
MCP_PUBLIC_BASE_URL=http://127.0.0.1:8000
