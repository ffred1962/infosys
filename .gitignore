.env

# Python bytecode cache
__pycache__/
*.pyc

# Coverage / test artifacts
.coverage
htmlcov/

# SQLite database (contains real user data — never commit)
data/*.db

# Generated, not source
openapi.json

# One-off 1С export files used for data imports — real business data,
# not source, never checked in (same convention as search_sources.json).
*.xls
*.xlsx
